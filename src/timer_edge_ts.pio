;
; Timer-Capture per PIO: flankengenaues Timestamping ohne Core-Last.
; Generisch fuer jede LPC1115-Input-Capture-Anwendung (Frequenzzaehler,
; Echo-/Pulsbreitenmessung, Decoder, KNX-Empfang, ...).
;
; Eine State-Machine fuehrt einen frei laufenden Abwaertszaehler in X. Bei JEDER
; Flanke am Capture-Pin wird (X[30:0] << 1) | Pinpegel in die RX-FIFO geschoben.
; Die CPU rechnet den Zaehlerstand ueber den Startzeitpunkt der SM in absolute
; Zeit um (pio_glue::ts_read_edge) und kennt die Flankenrichtung aus dem Pegel -
; auch wenn bei einem FIFO-Ueberlauf einmal eine Flanke verloren geht.
;
; Zeitbasis: JEDER Zweig kostet genau 2 Takte je Zaehlschritt - auch der
; Erfassungszweig (in/push sind mit einem jmp x-- gepaart). Frueher lief der
; Erfassungszweig 4 Takte ohne Dekrement: pro Flanke fehlten 2 Zaehlschritte,
; bei KNX (2 Flanken je Bit) summierte sich das auf zig us je Byte.
; Der Unterlauf von X (alle 2^32 Schritte) kostet einen Takt extra (vernachlaessigbar).

.program timer_edge_ts

    mov x, !null            ; X = 0xFFFFFFFF (einmalig vor wrap_target)
.wrap_target
high_loop:                  ; Pin aktuell HIGH
    jmp pin, high_count     ; weiterhin high -> zaehlen
    jmp x--, falling        ; high->low: zaehlen, weiter zur Erfassung
falling:
    in x, 31                ; ISR = X[30:0]
    jmp x--, f_level
f_level:
    in pins, 1              ; + Pegel (0) als LSB
    jmp x--, f_push
f_push:
    push noblock            ; -> RX-FIFO
    jmp x--, low_loop
low_loop:                   ; Pin aktuell LOW
    jmp pin, rising         ; low->high
    jmp x--, low_loop       ; X--, weiter (2 Takte je Iteration)
    jmp low_loop            ; X-Unterlauf: nur fortsetzen
rising:
    jmp x--, r_cap
r_cap:
    in x, 31
    jmp x--, r_level
r_level:
    in pins, 1              ; + Pegel (1)
    jmp x--, r_push
r_push:
    push noblock
    jmp x--, high_loop
high_count:
    jmp x--, high_loop      ; X--, weiter (2 Takte je Iteration)
    jmp high_loop           ; X-Unterlauf: nur fortsetzen
.wrap
