;
; KNX-/LPC-Capture per PIO: flankengenaues Timestamping ohne Core-Last.
;
; Idee: Eine State-Machine fuehrt einen frei laufenden 32-Bit-Abwaerts-
; zaehler in X. Bei JEDER Flanke am Capture-Pin (steigend ODER fallend) wird
; der aktuelle Zaehlerstand in die RX-FIFO geschoben. Die CPU rekonstruiert
; aus den Differenzen aufeinanderfolgender Zaehlerstaende die exakten
; Flankenabstaende (in TC-Ticks umgerechnet) und ordnet jeder Flanke per
; strikter Alternation (Bus-Idle = high -> erste Flanke fallend) eine
; Richtung zu.
;
; Wichtig: Jede "gleicher-Pegel"-Schleifeniteration dauert exakt 2 Takte,
; unabhaengig vom Pin-Pegel. Damit zaehlt X mit konstanter Rate
; clk_sys / (clkdiv * 2) herunter. Der Zaehler-Unterlauf (alle 2^32 Schritte)
; loest KEINE Scheinflanke aus (separater jmp), sondern setzt nur fort.
;
; FIFO-Tiefe 4 puffert mehrere Flanken; bei KNX (~104 us/Bit) reicht das
; auch bei traegem CPU-Polling locker.

.program knx_edge_ts

    mov x, !null            ; X = 0xFFFFFFFF (einmalig vor wrap_target)
.wrap_target
high_loop:                  ; Pin aktuell HIGH
    jmp pin, high_count     ; weiterhin high -> zaehlen
    jmp falling             ; high->low -> fallende Flanke
high_count:
    jmp x--, high_loop      ; X--, weiter (2 Takte je Iteration)
    jmp high_loop           ; X-Unterlauf: nur fortsetzen, keine Capture
falling:
    in x, 32                ; ISR = X
    push noblock            ; -> RX-FIFO
low_loop:                   ; Pin aktuell LOW
    jmp pin, rising         ; low->high -> steigende Flanke
    jmp x--, low_loop       ; X--, weiter (2 Takte je Iteration)
    jmp low_loop            ; X-Unterlauf: nur fortsetzen, keine Capture
rising:
    in x, 32                ; ISR = X
    push noblock            ; -> RX-FIFO
.wrap
